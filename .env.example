# Server Configuration
PORT=8080
GIN_MODE=debug

# Database Configuration (SQLite)
DB_PATH=./data/gorm.db

# Test Database Path (optional, for running tests)
# TEST_DB_PATH=./data/gorm_test.db

# logcore — error reporting to the Persea agents platform.
# The service keeps writing its own logs to stdout; only ERROR and above are
# shipped over HTTP to the gateway.
LOGCORE_ENABLED=true
LOGCORE_SERVICE=golang-gin-realworld-example-app
LOGCORE_ENV=dev
LOGCORE_URL=https://logcore-dev-352942961463.us-east4.run.app
LOGCORE_MIN_SEVERITY=ERROR

# Server secret: set it in the deployment's environment or secret manager.
# Never commit the real value.
LOGCORE_KEY=<your logcore api key>
